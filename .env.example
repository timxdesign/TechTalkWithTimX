# Public (safe to expose in the browser)
PUBLIC_SITE_URL=https://techtalkwithtimx.com
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=          # Supabase publishable key (sb_publishable_...)
PUBLIC_TURNSTILE_SITE_KEY=

# Server secrets (set with `npx wrangler secret put NAME` in production)
SUPABASE_SERVICE_ROLE_KEY=         # Supabase secret key (sb_secret_...)
TURNSTILE_SECRET_KEY=
CRON_SECRET=                       # any long random string; shared with workers/cron-newsletter

# Zoho ZeptoMail — transactional email
ZEPTOMAIL_TOKEN=                   # "Send Mail token" from your Mail Agent
ZEPTOMAIL_API_HOST=api.zeptomail.com   # api.zeptomail.eu / api.zeptomail.in for EU/India accounts
MAIL_FROM_ADDRESS=hello@techtalkwithtimx.com
EDITOR_ALERT_ADDRESS=              # where new story submissions are announced

# Zoho Campaigns — daily newsletter
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_HOST=accounts.zoho.com    # accounts.zoho.eu / .in to match your data centre
ZOHO_CAMPAIGNS_HOST=campaigns.zoho.com  # campaigns.zoho.eu / .in
ZOHO_CAMPAIGNS_LIST_KEY=

# ─── Podcast audio from YouTube (scripts only, never deployed) ──────────────
# Your channel's ID (UC…), from YouTube Studio → Settings → Channel → Advanced.
# npm run episode:audio only converts videos from this channel.
YOUTUBE_CHANNEL_ID=

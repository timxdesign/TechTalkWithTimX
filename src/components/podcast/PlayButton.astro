---
// Hands an episode to the persistent player. The player toggles data-state on
// this button, which swaps the icon and label via CSS.
interface Props {
  slug: string;
  title: string;
  audio: string | null;
  cover?: string | null;
  label?: string;
  size?: "sm" | "lg";
  tone?: "ink" | "paper";
  text?: string;
}

const { slug, title, audio, cover, label, size = "lg", tone = "ink", text = "Play episode" } = Astro.props;
---

{
  audio ? (
    <button
      type="button"
      data-play-episode
      data-state="idle"
      data-slug={slug}
      data-title={title}
      data-audio={audio}
      data-cover={cover ?? undefined}
      data-label={label}
      aria-pressed="false"
      class:list={[
        "play-btn group/play inline-flex items-center gap-3 rounded-full font-semibold transition-transform duration-300 hover:-translate-y-0.5",
        tone === "ink" ? "bg-ink text-paper" : "bg-paper text-ink",
        size === "lg" ? "py-2 pl-2 pr-6 text-base" : "py-1.5 pl-1.5 pr-4 text-sm",
      ]}
    >
      <span
        class:list={[
          "grid place-items-center rounded-full",
          tone === "ink" ? "bg-paper text-ink" : "bg-ink text-paper",
          size === "lg" ? "size-10" : "size-8",
        ]}
      >
        <svg class="icon-play" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 2.5v11a.5.5 0 0 0 .76.43l9-5.5a.5.5 0 0 0 0-.86l-9-5.5A.5.5 0 0 0 4 2.5Z" /></svg>
        <span class="icon-eq hidden items-end gap-[2px]" aria-hidden="true">
          <i class="block w-[3px] animate-[eq_0.9s_ease-in-out_infinite] bg-current" style="height:10px"></i>
          <i class="block w-[3px] animate-[eq_0.9s_ease-in-out_-0.3s_infinite] bg-current" style="height:14px"></i>
          <i class="block w-[3px] animate-[eq_0.9s_ease-in-out_-0.6s_infinite] bg-current" style="height:8px"></i>
        </span>
      </span>
      <span class="label-idle">{text}</span>
      <span class="label-playing hidden">Playing</span>
      <span class="label-paused hidden">Resume</span>
    </button>
  ) : (
    <span class="eyebrow">Audio coming soon</span>
  )
}

<style is:global>
  .play-btn[data-state="playing"] .icon-play { display: none; }
  .play-btn[data-state="playing"] .icon-eq { display: flex; }
  .play-btn[data-state="playing"] .label-idle,
  .play-btn[data-state="paused"] .label-idle { display: none; }
  .play-btn[data-state="playing"] .label-playing { display: inline; }
  .play-btn[data-state="paused"] .label-paused { display: inline; }
  @keyframes eq {
    0%, 100% { transform: scaleY(0.4); }
    50% { transform: scaleY(1); }
  }
  .icon-eq i { transform-origin: bottom; }
</style>

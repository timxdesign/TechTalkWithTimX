---
import Cover from "../ui/Cover.astro";
import type { StoryCard } from "../../lib/content";
import { formatDate } from "../../lib/format";

interface Props {
  story: StoryCard;
  variant?: "lead" | "standard" | "list" | "compact";
  index?: number;
  eager?: boolean;
}

const { story, variant = "standard", index, eager = false } = Astro.props;
const href = `/stories/${story.slug}`;
const kicker = story.series?.name ?? story.tags[0] ?? "Story";
const guestLine = story.guest ? [story.guest.name, story.guest.role, story.guest.company].filter(Boolean).join(", ") : null;
---

{
  variant === "lead" && (
    <article class="group grid gap-8 lg:grid-cols-12 lg:gap-12">
      <a href={href} class="block lg:col-span-7" tabindex="-1" aria-hidden="true">
        <Cover src={story.cover_url} alt={story.cover_alt} title={story.title} kicker={kicker} ratio="landscape" eager={eager} parallax sizes="(min-width: 1024px) 58vw, 100vw" />
      </a>
      <div class="flex flex-col justify-end lg:col-span-5">
        <p class="eyebrow" data-reveal>{kicker} · {formatDate(story.published_at)}</p>
        <h2 class="display mt-5 text-4xl sm:text-5xl xl:text-6xl" data-reveal>
          <a href={href} class="link-draw">{story.title}</a>
        </h2>
        {story.dek && <p class="mt-6 font-serif text-xl leading-relaxed text-ink-2" data-reveal>{story.dek}</p>}
        <div class="mt-8 flex items-center gap-4 border-t border-rule pt-5 text-sm" data-reveal>
          {guestLine && <span class="font-medium">{guestLine}</span>}
          {story.reading_minutes && <span class="eyebrow ml-auto">{story.reading_minutes} min read</span>}
        </div>
      </div>
    </article>
  )
}

{
  variant === "standard" && (
    <article class="group" data-reveal data-reveal-delay={index ? String((index % 3) * 0.08) : undefined}>
      <a href={href} class="block" tabindex="-1" aria-hidden="true">
        <Cover src={story.cover_url} alt={story.cover_alt} title={story.title} kicker={kicker} ratio="landscape" sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
      </a>
      <p class="eyebrow mt-5">{kicker}</p>
      <h3 class="headline mt-2.5 text-2xl">
        <a href={href} class="link-draw">{story.title}</a>
      </h3>
      {story.dek && <p class="mt-3 line-clamp-3 font-serif text-[1.05rem] leading-relaxed text-ink-2">{story.dek}</p>}
      <p class="eyebrow mt-4">
        {formatDate(story.published_at, "short")}
        {story.reading_minutes && <> · {story.reading_minutes} min</>}
      </p>
    </article>
  )
}

{
  variant === "list" && (
    <article class="group grid grid-cols-[1fr_auto] gap-6 border-t border-rule py-7 first-of-type:border-t-0 first-of-type:pt-0 sm:grid-cols-[7rem_1fr_9rem]" data-reveal>
      <p class="eyebrow hidden pt-1.5 sm:block">{formatDate(story.published_at, "short")}</p>
      <div>
        <p class="eyebrow sm:hidden">{formatDate(story.published_at, "short")}</p>
        <h3 class="headline mt-1 text-xl sm:mt-0 sm:text-2xl">
          <a href={href} class="link-draw">{story.title}</a>
        </h3>
        {story.dek && <p class="mt-2 line-clamp-2 font-serif text-[1.05rem] text-ink-2">{story.dek}</p>}
        <p class="eyebrow mt-3">{kicker}{story.reading_minutes && <> · {story.reading_minutes} min</>}</p>
      </div>
      <a href={href} class="block w-24 sm:w-36" tabindex="-1" aria-hidden="true">
        <Cover src={story.cover_url} alt="" title={story.title} kicker={null} ratio="square" sizes="9rem" />
      </a>
    </article>
  )
}

{
  variant === "compact" && (
    <article class="group flex gap-4 border-t border-rule py-5">
      {index != null && <span class="display w-8 shrink-0 text-3xl text-ink-3">{String(index + 1).padStart(2, "0")}</span>}
      <div>
        <p class="eyebrow">{kicker}</p>
        <h3 class="headline mt-1.5 text-lg">
          <a href={href} class="link-draw">{story.title}</a>
        </h3>
      </div>
    </article>
  )
}

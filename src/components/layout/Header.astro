---
import { NAV, SITE } from "../../lib/site";
import Logo from "./Logo.astro";
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/90 backdrop-blur-md" data-header>
  <div class="container-editorial flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3" aria-label={`${SITE.name}, home`}>
      <Logo class="h-6 w-auto md:h-7" />
      <span class="hidden text-[0.8rem] font-extrabold uppercase tracking-[-0.01em] lg:inline">
        Tech Talk <span class="serif-italic text-[0.95rem] normal-case">with</span> TimX
      </span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-8 text-[0.95rem] font-medium">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={["link-draw py-1", isActive(item.href) ? "text-ink" : "text-ink-2"]}
                aria-current={isActive(item.href) ? "page" : undefined}
                style={isActive(item.href) ? "background-size:100% 1px" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a href="/search" class="grid size-10 place-items-center rounded-full hover:bg-paper-2" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </a>
      <button type="button" class="grid size-10 place-items-center rounded-full hover:bg-paper-2" aria-label="Toggle dark mode" data-theme-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"></path></svg>
      </button>
      <a href="/share-your-story" class="btn-ink ml-2 hidden !px-4 !py-2 !text-sm sm:inline-flex">Share your story</a>
      <button
        type="button"
        class="grid size-10 place-items-center rounded-full hover:bg-paper-2 md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-rule bg-paper md:hidden" data-menu>
    <nav aria-label="Mobile" class="container-editorial py-6">
      <ul class="space-y-1">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="display block py-2 text-4xl">
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href="/share-your-story" class="display block py-2 text-4xl">Share your story</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function initHeader() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    toggle?.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("ttt-theme", next);
      } catch {}
    });

    const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = document.querySelector<HTMLElement>("[data-menu]");
    menuBtn?.addEventListener("click", () => {
      const open = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", String(!open));
      menuBtn.setAttribute("aria-label", open ? "Open menu" : "Close menu");
      menu?.classList.toggle("hidden", open);
    });
  }
  document.addEventListener("astro:page-load", initHeader);
</script>

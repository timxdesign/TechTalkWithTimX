---
import BaseLayout from "../layouts/BaseLayout.astro";
Astro.response.status = 404;
---

<BaseLayout title="Page not found" noindex>
  <section class="container-editorial py-28 md:py-40">
    <p class="eyebrow">404</p>
    <h1 class="display mt-5 max-w-4xl text-[clamp(3rem,9vw,8rem)]">
      This story <span class="serif-italic">hasn't been written yet.</span>
    </h1>
    <p class="mt-8 max-w-xl font-serif text-xl text-ink-2">The page you're looking for has moved or never existed.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="btn-ink">Back to the front page</a>
      <a href="/search" class="btn-line">Search</a>
    </div>
  </section>
</BaseLayout>

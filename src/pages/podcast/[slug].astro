---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Avatar from "../../components/ui/Avatar.astro";
import PlayButton from "../../components/podcast/PlayButton.astro";
import Waveform from "../../components/podcast/Waveform.astro";
import ShareLinks from "../../components/story/ShareLinks.astro";
import EpisodeCard from "../../components/podcast/EpisodeCard.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import NewsletterCTA from "../../components/newsletter/NewsletterCTA.astro";
import { getEpisodeBySlug, getEpisodes } from "../../lib/content";
import { episodeLabel, formatClock, formatDate, formatDuration } from "../../lib/format";
import { breadcrumbSchema, episodeSchema } from "../../lib/schema";
import { absoluteUrl } from "../../lib/site";
import { cachePage } from "../../lib/cache";

const { slug = "" } = Astro.params;
const episode = await getEpisodeBySlug(slug);
if (!episode) return Astro.rewrite("/404");

cachePage(Astro, ["episodes", `episode:${episode.slug}`]);

const more = (await getEpisodes({ limit: 4 })).filter((e) => e.id !== episode.id).slice(0, 3);
const label = episodeLabel(episode);
const youtubeId = episode.video_url?.match(/(?:youtu\.be\/|v=|embed\/)([\w-]{11})/)?.[1];

// Transcript: blank-line separated paragraphs; "Name: text" lines get a speaker label.
const transcript = (episode.transcript ?? "")
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean)
  .map((p) => {
    const m = p.match(/^([A-Z][\w .'-]{1,40}):\s+([\s\S]+)$/);
    return m ? { speaker: m[1], text: m[2] } : { speaker: null, text: p };
  });
---

<BaseLayout
  title={episode.seo_title ?? `${episode.title} (${label})`}
  description={episode.seo_description ?? episode.dek ?? undefined}
  image={episode.cover_url}
  type="article"
  publishedTime={episode.published_at}
  modifiedTime={episode.updated_at}
  schema={[
    episodeSchema(episode),
    breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Podcast", path: "/podcast" },
      { name: episode.title, path: `/podcast/${episode.slug}` },
    ]),
  ]}
>
  <article>
    <header class="grain bg-ink text-paper">
      <div class="container-editorial pt-14 pb-16 md:pt-20 md:pb-24">
        <nav aria-label="Breadcrumb" class="eyebrow flex gap-2 !text-paper/55" data-intro style="--d:.15s">
          <a href="/podcast" class="hover:text-paper">Podcast</a><span aria-hidden="true">/</span><span>{label}</span>
        </nav>
        <h1 class="display mt-6 max-w-5xl text-[clamp(2.6rem,6.5vw,6rem)]" data-intro>{episode.title}</h1>
        {episode.dek && <p class="mt-8 max-w-3xl font-serif text-[clamp(1.2rem,2vw,1.5rem)] text-paper/70" data-intro style="--d:.15s">{episode.dek}</p>}

        <div class="mt-12 grid items-end gap-10 lg:grid-cols-12" data-intro style="--d:.15s">
          <div class="lg:col-span-5">
            <PlayButton slug={episode.slug} title={episode.title} audio={episode.audio_url} cover={episode.cover_url} label={label} tone="paper" />
            <p class="eyebrow mt-5 !text-paper/55">
              <time datetime={episode.published_at ?? undefined}>{formatDate(episode.published_at)}</time> · {formatDuration(episode.duration_seconds)}
            </p>
          </div>
          <div class="lg:col-span-7">
            <Waveform seed={episode.slug} class="text-paper/80" />
          </div>
        </div>
      </div>
    </header>

    <div class="container-editorial mt-16 grid gap-14 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="space-y-10 lg:sticky lg:top-28">
          {
            episode.guest && (
              <div class="border-t-2 border-ink pt-5">
                <p class="eyebrow">Guest</p>
                <a href={`/people/${episode.guest.slug}`} class="group mt-4 flex items-center gap-3">
                  <Avatar name={episode.guest.name} src={episode.guest.avatar_url} size={52} />
                  <span>
                    <span class="block font-semibold"><span class="link-draw">{episode.guest.name}</span></span>
                    <span class="block text-sm text-ink-3">{[episode.guest.role, episode.guest.company].filter(Boolean).join(", ")}</span>
                  </span>
                </a>
              </div>
            )
          }
          {
            episode.chapters.length > 0 && (
              <div class="border-t-2 border-ink pt-5">
                <p class="eyebrow">Chapters</p>
                <ol class="mt-3">
                  {episode.chapters.map((c) => (
                    <li>
                      <button type="button" data-seek={c.start} data-slug={episode.slug} class="group flex w-full items-baseline gap-4 border-b border-rule py-3 text-left">
                        <span class="w-14 shrink-0 font-mono text-xs tabular-nums text-ink-3">{formatClock(c.start)}</span>
                        <span class="link-draw font-medium">{c.title}</span>
                      </button>
                    </li>
                  ))}
                </ol>
              </div>
            )
          }
          {
            episode.story && (
              <a href={`/stories/${episode.story.slug}`} class="group block rounded-xl bg-paper-2 p-6">
                <span class="eyebrow">Read the story</span>
                <span class="headline mt-2 block text-xl"><span class="link-draw">{episode.story.title}</span></span>
              </a>
            )
          }
        </div>
      </aside>

      <div class="min-w-0 lg:col-span-8">
        {
          youtubeId && (
            <div class="mb-14 aspect-video overflow-hidden rounded-xl bg-ink">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
                title={`Video: ${episode.title}`}
                loading="lazy"
                allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                class="h-full w-full"
              />
            </div>
          )
        }

        {
          episode.show_notes_html && (
            <section aria-labelledby="notes">
              <h2 id="notes" class="eyebrow mb-6">Show notes</h2>
              <div class="prose-editorial" set:html={episode.show_notes_html} />
            </section>
          )
        }

        {
          transcript.length > 0 && (
            <section class="mt-16 border-t border-rule pt-10" aria-labelledby="transcript">
              <details class="group" open={transcript.length < 12}>
                <summary class="flex cursor-pointer list-none items-center justify-between">
                  <h2 id="transcript" class="display text-3xl">Transcript</h2>
                  <span class="rounded-full border border-rule px-4 py-1.5 text-sm font-medium group-open:hidden">Read full transcript</span>
                  <span class="hidden rounded-full border border-rule px-4 py-1.5 text-sm font-medium group-open:inline">Collapse</span>
                </summary>
                <div class="mt-8 space-y-6 font-serif text-[1.1rem] leading-relaxed text-ink-2">
                  {transcript.map((p) => (
                    <p>
                      {p.speaker && <span class="mr-2 font-sans text-sm font-bold uppercase tracking-wide text-ink">{p.speaker}</span>}
                      {p.text}
                    </p>
                  ))}
                </div>
              </details>
            </section>
          )
        }

        <div class="mt-12 border-t border-rule pt-6">
          <ShareLinks url={absoluteUrl(`/podcast/${episode.slug}`)} title={episode.title} />
        </div>
      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="container-editorial mt-28" aria-label="More episodes">
        <SectionHeader title="More episodes" href="/podcast" linkText="All episodes" />
        {more.map((ep) => <EpisodeCard episode={ep} />)}
      </section>
    )
  }

  <NewsletterCTA source={`episode:${episode.slug}`} title="Never miss an episode." />
</BaseLayout>

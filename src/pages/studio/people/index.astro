---
import StudioLayout from "../../../layouts/StudioLayout.astro";

const { data } = await Astro.locals.supabase!.from("people").select("id, name, role, company, is_staff, avatar_url").order("name");
---

<StudioLayout title="People">
  <a slot="actions" href="/studio/people/new" class="rounded-md bg-ink px-4 py-2 text-sm font-semibold text-paper">Add person</a>
  <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    {
      (data ?? []).map((p) => (
        <li>
          <a href={`/studio/people/${p.id}`} class="flex items-center gap-4 rounded-xl border border-rule bg-paper p-4 transition-colors hover:border-ink">
            {p.avatar_url ? (
              <img src={p.avatar_url} alt="" class="size-12 rounded-full object-cover" />
            ) : (
              <span class="grid size-12 place-items-center rounded-full bg-ink text-sm font-bold text-paper">{p.name.slice(0, 1)}</span>
            )}
            <span class="min-w-0">
              <span class="block truncate font-semibold">{p.name}{p.is_staff && <span class="ml-2 text-xs font-normal text-ink-3">Staff</span>}</span>
              <span class="block truncate text-sm text-ink-3">{[p.role, p.company].filter(Boolean).join(", ")}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</StudioLayout>

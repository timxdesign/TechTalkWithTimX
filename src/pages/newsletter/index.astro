---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsletterForm from "../../components/forms/NewsletterForm";
import { getNewsletterIssues } from "../../lib/content";
import { formatDate } from "../../lib/format";
import { cachePage } from "../../lib/cache";

cachePage(Astro, ["newsletter"]);
const issues = await getNewsletterIssues(8);
const invalid = Astro.url.searchParams.get("status") === "invalid";

const promises = [
  { title: "Every morning", text: "The newest founder stories and podcast conversations, before your first meeting." },
  { title: "Five minutes", text: "Tight summaries and the one lesson worth stealing from each story." },
  { title: "No noise", text: "No funding-round churn, no hot takes. Just builders, in their own words." },
];
---

<BaseLayout
  title="Newsletter"
  description="The daily brief for builders: the newest founder stories and podcast conversations from Tech Talk with TimX, every morning."
>
  <section class="grain bg-ink text-paper">
    <div class="container-editorial grid gap-14 pt-16 pb-20 md:pt-24 md:pb-28 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow !text-paper/55" data-intro style="--d:.15s">The newsletter</p>
        <h1 class="display mt-5 text-[clamp(3rem,8vw,7.5rem)]" data-intro>
          The daily brief <span class="serif-italic">for builders.</span>
        </h1>
      </div>
      <div class="flex flex-col justify-end lg:col-span-5" data-intro style="--d:.15s">
        {invalid && <p role="alert" class="mb-4 rounded-lg bg-paper/10 px-4 py-3 text-sm">That link has expired or isn't valid. Subscribe again below.</p>}
        <NewsletterForm client:load source="newsletter-page" tone="paper" showName />
      </div>
    </div>
  </section>

  <section class="container-editorial mt-20 grid gap-10 md:grid-cols-3">
    {
      promises.map((p, i) => (
        <div class="border-t-2 border-ink pt-5" data-reveal data-reveal-delay={String(i * 0.08)}>
          <p class="headline text-2xl">{p.title}</p>
          <p class="mt-3 font-serif text-lg text-ink-2">{p.text}</p>
        </div>
      ))
    }
  </section>

  {
    issues.length > 0 && (
      <section class="container-editorial mt-24" aria-labelledby="recent">
        <div class="mb-6 flex items-end justify-between border-b-2 border-ink pb-4">
          <h2 id="recent" class="display text-3xl">Recent issues</h2>
          <a href="/newsletter/archive" class="link-draw text-sm font-semibold">Archive →</a>
        </div>
        <ul>
          {issues.map((i) => (
            <li class="border-b border-rule">
              <a href={`/newsletter/archive/${i.slug}`} class="group grid gap-2 py-5 sm:grid-cols-[10rem_1fr]">
                <span class="eyebrow pt-1">{formatDate(i.sent_at, "short")}</span>
                <span>
                  <span class="headline block text-xl"><span class="link-draw">{i.subject}</span></span>
                  {i.preview_text && <span class="mt-1 block font-serif text-ink-2">{i.preview_text}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Seo, { type SeoProps } from "../components/layout/Seo.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import AudioPlayer from "../components/podcast/AudioPlayer";
import { organizationSchema, websiteSchema } from "../lib/schema";

type Props = SeoProps & { bare?: boolean };

const { schema = [], bare = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Seo {...seo} schema={[organizationSchema(), websiteSchema(), ...schema]} />

    <!-- Set the theme and motion flags before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function apply() {
          var stored = null;
          try { stored = localStorage.getItem("ttt-theme"); } catch (e) {}
          var dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
          root.dataset.theme = dark ? "dark" : "light";
          if (!matchMedia("(prefers-reduced-motion: reduce)").matches) root.classList.add("motion-ok");
        }
        apply();
        document.addEventListener("astro:after-swap", apply);
        // Failsafe: if the motion script never loads, don't leave content hidden.
        setTimeout(function () {
          if (!window.__tttMotion) root.classList.remove("motion-ok");
        }, 3000);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>
    {!bare && <Header />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
    <AudioPlayer client:idle transition:persist="player" />
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
